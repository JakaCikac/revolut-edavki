# Security settings
TAX_SALT=change_this_to_a_random_string_in_production
UPLOAD_PATH=uploads

# Application settings
DEBUG=false
PORT=59855
HOST=0.0.0.0

# CORS Configuration
# For development: CORS_ORIGINS=*
# For production: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*

# Rate Limiting
# Format: "X per Y" where Y can be: second, minute, hour, day
RATE_LIMIT=100 per hour
RATE_LIMIT_STORAGE=memory://

# File Upload
MAX_FILE_SIZE=16777216

# Phase 2 Security Configuration
# Add your Phase 2 security configuration options here

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
