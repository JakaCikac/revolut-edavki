[MASTER]
ignore=.venv,venv,env,build,dist,.git
jobs=1

[MESSAGES CONTROL]
disable=
    C0111,  # missing-docstring
    C0103,  # invalid-name
    R0913,  # too-many-arguments
    R0914,  # too-many-locals
    W0212,  # protected-access
    W0511,  # fixme
    R0801,  # duplicate-code

[FORMAT]
max-line-length=120
indent-string='    '

[BASIC]
good-names=i,j,k,ex,_,id,df,tx

[DESIGN]
max-attributes=10
max-args=8
